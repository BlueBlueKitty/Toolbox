# -*- mode: python ; coding: utf-8 -*-

import os
from osgeo import __file__ as gdal_file


# 动态收集需要打包的资源，避免依赖 DEM_downloader 项目路径
datas = [
    ('src', 'src'),
    ('resources', 'resources'),
]

# GDAL/PROJ 运行时数据
# 先尝试从 osgeo 包目录获取（pip 安装的 GDAL）
_osgeo_dir = os.path.dirname(gdal_file)
_gdal_data_pip = os.path.join(_osgeo_dir, 'data', 'gdal')
_proj_data_pip = os.path.join(_osgeo_dir, 'data', 'proj')

# 再尝试从 conda 环境的 Library/share 目录获取（conda 安装的 GDAL）
_conda_prefix = os.environ.get('CONDA_PREFIX', '')
_gdal_data_conda = os.path.join(_conda_prefix, 'Library', 'share', 'gdal')
_proj_data_conda = os.path.join(_conda_prefix, 'Library', 'share', 'proj')

# 选择存在的路径
_gdal_data = _gdal_data_pip if os.path.exists(_gdal_data_pip) else _gdal_data_conda
_proj_data = _proj_data_pip if os.path.exists(os.path.join(_proj_data_pip, 'proj.db')) else _proj_data_conda

if os.path.exists(_gdal_data):
    datas.append((_gdal_data, 'gdal_data'))
if os.path.exists(_proj_data):
    datas.append((_proj_data, 'proj_data'))

# 行政区划数据库：已通过 resources 目录打包，无需再次添加
# _admin_db = os.path.join(os.getcwd(), 'resources', 'administrative_boundaries.db')
# if os.path.exists(_admin_db):
#     datas.append((_admin_db, 'data/administrative_boundaries.db'))

# 自定义运行时钩子，用于在 GDAL/osgeo 导入前设置 PROJ_LIB
_runtime_hooks = ['hooks/pyi_rth_proj.py']

a = Analysis(
    ['main.py'],
    pathex=[],
    binaries=[],
    datas=datas,
    hiddenimports=[
        'PySide6.QtUiTools',
        'numpy._core._exceptions',
        'numpy._core._multiarray_umath',
        'numpy._core._dtype_ctypes',
        'h5py.defs',
        'h5py.utils',
        'h5py.h5ac',
        'h5py._proxy',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=_runtime_hooks,
    excludes=['PyQt5', 'PyQt6'],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='Toolbox',
    debug=False,
    bootloader_ignore_signals=False,
    strip=True,
    upx=True,
    console=True,
    disable_windowed_traceback=False,
    icon=['resources\\toolbox.ico'],
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name='Toolbox',
)
